{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Celang",
  "scopeName": "source.celang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#stdlib" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.celang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.celang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.celang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.celang",
              "match": "\\\\."
            },
            {
              "name": "variable.other.interpolated.celang",
              "match": "\\{[^\\}]+\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.celang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.celang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.template.celang",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.celang",
              "match": "\\\\."
            },
            {
              "name": "variable.other.interpolated.celang",
              "match": "\\$\\{[^\\}]+\\}"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.celang",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.celang",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.celang",
          "match": "\\b(buat|konstanta|bentuk|fungsi|itu|let|const|var|def|function|struct|jieun|tetep)\\b"
        },
        {
          "name": "keyword.control.flow.celang",
          "match": "\\b(jika|selain jika|selain|selama|untuk|dalam|kembalikan|berhenti|lanjut|if|else|elif|while|for|in|return|break|continue|lamun|salami|pikeun|balikkeun)\\b"
        },
        {
          "name": "keyword.control.concurrency.celang",
          "match": "\\b(sambil|bersamaan|async|parallel|bari|babarengan)\\b"
        },
        {
          "name": "keyword.control.exception.celang",
          "match": "\\b(coba|tangkap|akhirnya|lempar|try|catch|finally|throw|raise)\\b"
        },
        {
          "name": "keyword.other.styling.celang",
          "match": "\\b(gaya|style|dialek)\\b"
        },
        {
          "name": "variable.language.this.celang",
          "match": "\\b(diri|this|self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.celang",
          "match": "\\b(Angka|Teks|Logika|Array|Map|Bentuk|Number|String|Boolean)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.celang",
          "match": "\\b(benar|salah|true|false|True|False|bener)\\b"
        },
        {
          "name": "constant.language.null.celang",
          "match": "\\b(kosong|nihil|null|None)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.celang",
          "match": "\\b(cetak|masukan|panjang|tipe|rentang|saring|petakan|potong_spasi|kapitalisasi|print|input|len|type|range|filter|map|trim)\\b"
        }
      ]
    },
    "stdlib": {
      "patterns": [
        {
          "name": "support.class.stdlib.celang",
          "match": "\\b(matematika|math|teks|strings|waktu|time|berkas|fs|json)\\b"
        },
        {
          "name": "support.variable.property.timetravel.celang",
          "match": "\\b(sebelumnya|prev|previous|awal|initial|first|histori|history)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.celang",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.logical.celang",
          "match": "\\b(dan|atau|bukan|and|or|not|sareng|atawa|sanes)\\b"
        },
        {
          "name": "keyword.operator.comparison.celang",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.celang",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.celang",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.celang",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}
