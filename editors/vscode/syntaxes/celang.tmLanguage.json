{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Celang",
  "scopeName": "source.celang",
  "patterns": [
    { "include": "#directives" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#stdlib" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.celang",
          "match": "\\b(\"use (universal|english|standard)\"|'use (universal|english|standard)')"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.celang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.celang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.celang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.celang",
              "match": "\\\\."
            },
            {
              "name": "variable.other.interpolated.celang",
              "match": "\\{[^\\}]+\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.celang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.celang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.template.celang",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.celang",
              "match": "\\\\."
            },
            {
              "name": "variable.other.interpolated.celang",
              "match": "\\$\\{[^\\}]+\\}"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.celang",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.celang",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.celang",
          "match": "\\b(buat|konstanta|tetap|konstan|bentuk|fungsi|itu|let|const|var|def|func|fn|function|struct|jieun|tetep|rujuk|ref|tipe|privat|reaktif|reactive)\\b"
        },
        {
          "name": "keyword.control.transaction.celang",
          "match": "\\b(transaksi|batalkan|pulihkan|transaction|rollback|recover)\\b"
        },
        {
          "name": "keyword.control.reactive.celang",
          "match": "\\b(pantau|watch)\\b"
        },
        {
          "name": "keyword.operator.cast.celang",
          "match": "\\b(sebagai|as)\\b"
        },
        {
          "name": "keyword.control.flow.celang",
          "match": "\\b(jika|kalau|bila|selain jika|lain jika|selain|lain|maka|selama|untuk|dalam|kembalikan|mengembalikan|berhenti|lanjut|if|else|elif|while|for|in|return|break|continue|lamun|salami|pikeun|balikkeun|cocok|kasus|lainnya|switch|case|default)\\b"
        },
        {
          "name": "keyword.control.concurrency.celang",
          "match": "\\b(sambil|bersamaan|async|parallel|bari|babarengan|titip|jemput|await)\\b"
        },
        {
          "name": "keyword.control.defer.celang",
          "match": "\\b(defer|saat_selesai)\\b"
        },
        {
          "name": "keyword.control.exception.celang",
          "match": "\\b(coba|tangkap|akhirnya|lempar|try|catch|finally|throw|raise)\\b"
        },
        {
          "name": "keyword.other.styling.celang",
          "match": "\\b(gaya|style|dialek)\\b"
        },
        {
          "name": "variable.language.this.celang",
          "match": "(@[a-zA-Z_][a-zA-Z0-9_]*|\\b(diri|this|self)\\b)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.celang",
          "match": "\\b(Angka|Pecahan|Teks|Logika|Array|Map|Bentuk|Number|Float|String|Boolean|Saluran|Channel|channel|Tiket|Ticket)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.celang",
          "match": "\\b(benar|salah|true|false|True|False|bener)\\b"
        },
        {
          "name": "constant.language.null.celang",
          "match": "\\b(kosong|nihil|null|None)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.celang",
          "match": "\\b(cetak|masukan|panjang|tipe|rentang|saring|petakan|potong_spasi|kapitalisasi|print|input|len|length|type|range|filter|map|trim|capitalize|uppercase|salin|clone|terbilang|rupiah|format_rupiah|format_usd|format_currency|in_words|spelled_out|dollars_in_words|titip|jemput|jemput_semua|jemput_pertama|await_all|await_race|await_first|Saluran|Channel)\\b"
        }
      ]
    },
    "stdlib": {
      "patterns": [
        {
          "name": "support.class.stdlib.celang",
          "match": "\\b(matematika|math|teks|strings|waktu|time|berkas|fs|json|sistem|os)\\b"
        },
        {
          "name": "support.variable.property.timetravel.celang",
          "match": "(?<=\\.)(sebelumnya|prev|previous|awal|initial|first|histori|history)\\b"
        },
        {
          "name": "support.variable.property.cultural.celang",
          "match": "(?<=\\.)(rupiah|terbilang|kata|ejaan|ribu|thousand|k|juta|million|miliar|milyar|billion|triliun|trilyun|trillion|usd|dollar|dollars|words|in_words|dollars_in_words|milidetik|ms|detik|s|sec|second|seconds|menit|m|min|minute|minutes|jam|h|hour|hours|hari|d|day|days|b|byte|bytes|kb|kilobyte|mb|megabyte|gb|gigabyte|tb|terabyte)\\b"
        },
        {
          "name": "support.function.method.channel.celang",
          "match": "(?<=\\.)(kirim|terima|tutup|send|receive|recv|close|selesai|hasil|done|result)\\b"
        },
        {
          "name": "support.function.method.collections.celang",
          "match": "(?<=\\.)(push|tambah|pop|hapus_terakhir|ambil_terakhir|shift|hapus_awal|geser|unshift|sisipkan_depan|sisipkan_awal|sisip_depan|insert|sisipkan|sisip|remove_at|delete_at|hapus_indeks|reverse|balik|sort|urut|join|gabung|contains|includes|berisi|index_of|indeks_dari|clear|bersihkan|slice|potong|concat|gabungkan|size|ukuran|keys|kunci|values|nilai|entries|entri|has|memiliki|get|ambil|set|atur|delete|remove|hapus|merge)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.celang",
          "match": "=>"
        },
        {
          "name": "keyword.operator.nullsafety.celang",
          "match": "(\\?\\.|\\?\\?)"
        },
        {
          "name": "keyword.operator.pipeline.celang",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.logical.celang",
          "match": "(\\b(dan|atau|bukan|and|or|not|sareng|atawa|sanes)\\b|(&&|\\|\\||!))"
        },
        {
          "name": "keyword.operator.comparison.celang",
          "match": "(===|!==|==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.celang",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.celang",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.celang",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}
